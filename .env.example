# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://copilot:change-me@localhost:5432/copilot

# Auth (Phase 2): long random string used to sign session JWTs
JWT_SECRET=change-me

# LLM (Phase 4)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Embeddings (Phase 3): provider not chosen yet
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Service URLs
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://localhost:8001/mcp
# Read by frontend/next.config.ts at build time for the /api proxy
BACKEND_URL=http://localhost:8000
