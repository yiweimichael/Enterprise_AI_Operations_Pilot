# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://copilot:change-me@localhost:5432/copilot

# Auth (Phase 2)
# Signs session JWTs; required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Password for the seeded demo users (analyst@, manager@, admin@example.com)
DEMO_PASSWORD=demo-password
# Set to true when served over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# LLM (Phase 4)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Embeddings (Phase 3)
# openai (default) or fake: deterministic test vectors that need no API key
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# OpenAI API key, used only for embeddings
EMBEDDING_API_KEY=

# Retrieval (Phase 3)
# Passages less similar than this are dropped; recalibrate when the embedding model changes
RETRIEVAL_MIN_SIMILARITY=0.5
RETRIEVAL_TOP_K=5

# Service URLs
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://localhost:8001/mcp
# Read by frontend/next.config.ts at build time for the /api proxy
BACKEND_URL=http://localhost:8000
